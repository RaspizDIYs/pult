{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pult",
  "version": "../package.json",
  "identifier": "ru.raspizdiys.pult",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Пульт",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RaspizDIYs/pult/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENjM0ODYxNUQxNTVBNzIKUldSeVdoVmRZVWhqWFZLWTZKNkVYTjhOb0VTK0E5bS8vMkhwOFFKMy9Uak1qTVlRdXlRWlhkNkcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
